PGHOST=localhost
PGPORT=5432
PGDATABASE=nyc311
PGUSER=postgres
PGPASSWORD=changeme
SOCRATA_APP_TOKEN=

# --- nightly export e-mail delivery (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EXPORT_EMAIL_FROM=nyc311-bot@example.com
EXPORT_EMAIL_TO=analytics@example.com,ops@example.com
EXPORT_EMAIL_CC=

# --- Slack alerts for each nightly run (optional; webhook OR bot token) ---
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#ops-311

# Public/share prefix used to turn export file names into clickable links
# in Slack and on the status dashboard. Leave blank to post plain paths.
EXPORT_BASE_URL=

# --- observability -----------------------------------------------------------
# node_exporter textfile collector target (or leave the default in-repo path)
PROMETHEUS_TEXTFILE_PATH=reports/metrics/nyc311.prom
# optional: push instead of / as well as the textfile
PROMETHEUS_PUSHGATEWAY_URL=
